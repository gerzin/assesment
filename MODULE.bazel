module(
    name = "assesment",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.9")
bazel_dep(name = "rules_python", version = "1.7.0-rc4")
bazel_dep(name = "rules_uv", version = "0.88.0")
bazel_dep(name = "googletest", version = "1.14.0.bcr.1")
bazel_dep(name = "spdlog", version = "1.16.0.bcr.1")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "0e990032f3c5a866e72615cf67e5ce22186dcb97",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.13",
    requirements_lock = "//ground_control:requirements_lock.txt",
)
use_repo(pip, "pypi")

uv = use_extension("@rules_uv//uv:extensions.bzl", "uv")
uv.pip_compile(
    name = "uv_python",
    requirements_in = "//ground_control:requirements.txt",
    requirements_txt = "//ground_control:requirements_lock.txt",
)
use_repo(uv, "uv_python")
