load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "onboard_lib",
    srcs = ["onboard.cpp"],
    hdrs = ["onboard.hpp"],
    copts = ["-std=c++23"],
    visibility = ["//visibility:public"],
    deps = [],
)

# Shared library for Python ctypes
cc_binary(
    name = "libonboard.so",
    srcs = [
        "onboard.cpp",
        "onboard.hpp",
    ],
    copts = [
        "-std=c++23",
        "-fPIC",
    ],
    linkshared = True,
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "onboard_app",
    srcs = ["main.cpp"],
    copts = ["-std=c++23"],
    deps = [
        ":onboard_lib",
        "//third_party/argparse",
        "@spdlog",
    ],
)
